	        </xsd:element>
	        <xsd:element minOccurs="0" name="MaileeGivenName"
	            type="xsd:string">
	            <xsd:annotation></xsd:annotation>
	        </xsd:element>
	        <xsd:element minOccurs="0" name="MaileeSurname"
	            type="xsd:string">
	            <xsd:annotation></xsd:annotation>
	        </xsd:element>
	    </xsd:all>
	</xsd:complexType>
	<xsd:complexType
	    name="StructuredAddresseeIndividualIdentificationComplexType">
	    <xsd:all>
	        <xsd:element minOccurs="0" name="AddresseeFormOfAddress"
	            type="xsd:string">
	            <xsd:annotation></xsd:annotation>
	        </xsd:element>
	        <xsd:element minOccurs="0" name="AddresseeGivenName"
	            type="xsd:string">
	            <xsd:annotation></xsd:annotation>
	        </xsd:element>
	        <xsd:element minOccurs="0" name="AddresseeSurname"
	            type="xsd:string">
	            <xsd:annotation></xsd:annotation>
	        </xsd:element>
	        <xsd:element minOccurs="0"
	            name="AddresseeSupplementaryDispatchInfo"
	            type="xsd:string">
	            <xsd:annotation></xsd:annotation>
	        </xsd:element>
	    </xsd:all>
	</xsd:complexType>
	<xsd:complexType
	    name="StructuredOtherDeliveryInformationComplexType">
	    <xsd:all>
	        <xsd:element minOccurs="0" name="DeliveryServiceType"
	            type="xsd:string">
	            <xsd:annotation></xsd:annotation>
	        </xsd:element>
	        <xsd:element minOccurs="0" name="DeliveryServiceIndicator"
	            type="xsd:string">
	            <xsd:annotation></xsd:annotation>
	        </xsd:element>
	    </xsd:all>
	</xsd:complexType>
	<xsd:complexType
	    name="StructuredDeliveryPointLocationComplexType">
	    <xsd:all>
	        <xsd:element minOccurs="0" name="StreetName"
	            type="xsd:string">
	            <xsd:annotation></xsd:annotation>
	        </xsd:element>
	        <xsd:element minOccurs="0" name="StreetNumber"
	            type="xsd:string">
	            <xsd:annotation></xsd:annotation>
	        </xsd:element>
	        <xsd:element minOccurs="0" name="BoxNumber"
	            type="xsd:string">
	            <xsd:annotation></xsd:annotation>
	        </xsd:element>
	    </xsd:all>
	</xsd:complexType>
	<xsd:complexType
	    name="StructuredPostalCodeMunicipalityComplexType">
	    <xsd:all>
	        <xsd:element minOccurs="0" name="PostalCode"
	            type="xsd:string">
	            <xsd:annotation></xsd:annotation>
	        </xsd:element>
	        <xsd:element minOccurs="0" name="MunicipalityName"
	            type="xsd:string">
	            <xsd:annotation></xsd:annotation>
	        </xsd:element>
	        <xsd:element minOccurs="0" name="DeliveryServiceQualifier"
	            type="xsd:string">
	            <xsd:annotation></xsd:annotation>
	        </xsd:element>
	    </xsd:all>
	</xsd:complexType>
	<xsd:complexType
	    name="AddresseeIndividualIdentificationComplexType">
	    <xsd:choice>
	        <xsd:element
	            ref="msg:StructuredAddresseeIndividualIdentification">
	        </xsd:element>
	        <xsd:element
	            name="UnstructuredAddresseeIndividualIdentification"
	            type="xsd:string">
	        </xsd:element>
	    </xsd:choice>
	</xsd:complexType>
	<xsd:complexType name="MaileeIndividualIdentificationComplexType">
	    <xsd:choice>
	        <xsd:element
	            ref="msg:StructuredMaileeIndividualIdentification">
	        </xsd:element>
	        <xsd:element
	            name="UnstructuredMaileeIndividualIdentification"
	            type="xsd:string">
	        </xsd:element>
	    </xsd:choice>
	</xsd:complexType>
	<xsd:complexType
	    name="MaileeOrganizationIdentificationComplexType">
	    <xsd:choice>
	        <xsd:element
	            ref="msg:StructuredMaileeOrganizationIdentification">
	        </xsd:element>
	        <xsd:element
	            name="UnstructuredMaileeOrganizationIdentification"
	            type="xsd:string">
	        </xsd:element>
	    </xsd:choice>
	</xsd:complexType>
	<xsd:complexType
	    name="MailRecipientDispatchingInformationComplexType">
	    <xsd:choice>
	        <xsd:element
	            ref="msg:StructuredMailRecipientDispatchingInformation">
	        </xsd:element>
	        <xsd:element
	            name="UnstructuredMailRecipientDispatchingInformation"
	            type="xsd:string">
	        </xsd:element>
	    </xsd:choice>
	</xsd:complexType>
	<xsd:complexType name="OtherDeliveryInformationComplexType">
	    <xsd:choice>
	        <xsd:element ref="msg:StructuredOtherDeliveryInformation"></xsd:element>
	        <xsd:element name="UnstructuredOtherDeliveryInformation"
	            type="xsd:string">
	        </xsd:element>
	    </xsd:choice>
	</xsd:complexType>
	<xsd:complexType name="DeliveryPointLocationComplexType">
	    <xsd:choice>
	        <xsd:element ref="msg:StructuredDeliveryPointLocation"></xsd:element>
	        <xsd:element name="UnstructuredDeliveryPointLocation"
	            type="xsd:string">
	        </xsd:element>
	    </xsd:choice>
	</xsd:complexType>
	<xsd:complexType name="PostalCodeMunicipalityComplexType">
	    <xsd:choice>
	        <xsd:element ref="msg:StructuredPostalCodeMunicipality"></xsd:element>
	        <xsd:element name="UnstructuredPostalCodeMunicipality"
	            type="xsd:string">
	        </xsd:element>
	    </xsd:choice>
	</xsd:complexType>
	
	<xsd:element name="TransactionID" type="xsd:string">
		<xsd:annotation>
			<xsd:documentation>ID which identifies the address validation. Together with the ValidationRequestID, this id defines an address validation uniquely. Used for feedback and acces logging purposes.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ValidationRequestID" type="xsd:string">
		<xsd:annotation>
			<xsd:documentation>ID which identifies the address validation request uniquely. Used for feedback and acces logging purposes.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	
	<xsd:complexType name="AddressBlockLinesType">
		<xsd:sequence>
			<xsd:element ref="msg:UnstructuredAddressLine" minOccurs="0" maxOccurs="7"/>
		</xsd:sequence>
	</xsd:complexType>
	
	<xsd:element name="UnstructuredAddressLine" type="msg:LocalizedStringType"/>
	
	<xsd:complexType name="LocalizedStringType">
		<xsd:annotation>
			<xsd:documentation>Type representing a textual, language-dependent LocalizedString of an element or an entity. The content of this type is typically retrieved from a Master Data Management system that supports multilanguage entities. It is not intended for free-text input purposes.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="xsd:string">
				<xsd:attribute name="locale" type="msg:LanguageCodeType" use="optional" default="en"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:simpleType name="LanguageCodeType">
		<xsd:annotation>
			<xsd:documentation>Restricted list of language types, supported by bpost</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:language">
			<xsd:enumeration value="nl"/>
			<xsd:enumeration value="fr"/>
			<xsd:enumeration value="en"/>
			<xsd:enumeration value="de"/>
		</xsd:restriction>
	</xsd:simpleType>
	
	<xsd:element name="CallerIdentification" type="msg:CallerIdentificationType">
		<xsd:annotation>
			<xsd:documentation>Information about the caller of the service, in case no authentication mechanism exists. </xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:complexType name="CallerIdentificationType">
		<xsd:annotation>
			<xsd:documentation>The caller can be identified with a caller name (in case the service is called by a person).</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="CallerName" type="xsd:string"/>
		</xsd:sequence>
	</xsd:complexType>
	
	<xsd:element name="Result" type="msg:ResultType"/>
	<xsd:simpleType name="ResultType">
		<xsd:annotation>
			<xsd:documentation>Type used to standardize the terminology used to indicate whether an operation completed successfully. In case an operation fails, it should throw a fault. Can be potentially be extended with a WARNING.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="REGISTERED">
				<xsd:annotation>
					<xsd:documentation>The action was registered successfully, typically used to indicate that the request was received correctly, but that the execution is deferred (and therefore, the execution can still fail).</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="SUCCESS">
				<xsd:annotation>
					<xsd:documentation>The action was executed successfully.</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="FAILURE">
				<xsd:annotation>
					<xsd:documentation>The action was not or only partially executed. Typically used when it is part of a series of actions that don't need to be executed in one atomic unit of work. If it was part of an atomic unit of work, an error should be thrown instead.</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="NOT_APPLICABLE">
				<xsd:annotation>
					<xsd:documentation>The action did not have a result on this specific part, and therefore the result is not applicable.</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
		</xsd:restriction>
	</xsd:simpleType>

	
</xsd:schema>